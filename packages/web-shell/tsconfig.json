{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hoptrendy/sdk": ["../sdk-typescript/src/index.ts"],
      "@hoptrendy/sdk/daemon": ["../sdk-typescript/src/daemon/index.ts"],
      "@hoptrendy/sdk/*": ["../sdk-typescript/src/*/index.ts"],
      "@hoptrendy/webui": ["../webui/src/index.ts"],
      "@hoptrendy/webui/daemon-react-sdk": ["../webui/src/daemon-react-sdk.ts"],
      "@hoptrendy/webui/*": ["../webui/src/*/index.ts"]
    }
  },
  "include": ["client/**/*.ts", "client/**/*.tsx"],
  "exclude": [
    "client/**/*.test.ts",
    "client/**/*.test.tsx",
    "client/e2e/**",
    "client/test/**",
    "node_modules",
    "dist"
  ]
}
